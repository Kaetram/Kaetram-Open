---
import DefaultLayout from '../layouts/default.astro';
import '../scss/main.scss';
---

<DefaultLayout title="Unavailable">
    <div id="intro">
        <section id="parchment" class="slice-menu">
            <article id="unavailable-screen">
                <h1 class="title-decoration">Sprite Land</h1>

                <p>
                    Sprite Land Beta2
                
                </p>
            </article>
        </section>
    </div>
</DefaultLayout>

<style is:global>
    #unavailable-screen {
        pointer-events: auto;
        opacity: 1;

        p {
            margin-top: 3em;
        }
    }
</style>
